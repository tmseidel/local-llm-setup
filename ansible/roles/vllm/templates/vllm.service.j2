[Unit]
Description=vLLM — OpenAI-kompatibler LLM Inference Server ({{ vllm_model }})
Documentation=https://docs.vllm.ai
Wants=network-online.target
After=network-online.target
# Erst starten wenn NVIDIA-Treiber geladen ist
After=nvidia-persistenced.service

[Service]
Type=simple
User={{ vllm_user }}
Group={{ vllm_user }}
WorkingDirectory={{ vllm_install_dir }}
ExecStart={{ vllm_install_dir }}/start.sh
ExecReload=/bin/kill -HUP $MAINPID

# Logging
StandardOutput=append:{{ vllm_log_dir }}/vllm.log
StandardError=append:{{ vllm_log_dir }}/vllm.log

# Neustart-Verhalten
Restart={{ vllm_service_restart }}
RestartSec={{ vllm_service_restart_sec }}
# Keine Begrenzung der Neustarts, damit der Dienst nach Treiber-/CUDA-
# Fehlern oder OOM-Situationen nicht dauerhaft deaktiviert wird.
StartLimitIntervalSec=0
StartLimitBurst=0

# Ressourcen-Limits
# OOM-Killer soll andere Prozesse bevorzugen, nicht vLLM
OOMScoreAdjust=-100
# vLLM braucht viel Arbeitsspeicher für GPU-Transfers
LimitMEMLOCK=infinity
LimitNOFILE=65536

# GPU-Zugriff sicherstellen
Environment=CUDA_VISIBLE_DEVICES=0,1
Environment=HF_HOME={{ vllm_hf_cache_dir }}
Environment=PYTHONUNBUFFERED=1

# Timeout: vLLM-Start dauert 1–5 Minuten wegen Modell-Download/-Laden.
# StartLimit ist ausgeschaltet, daher kann der Service beliebig oft neu versuchen.
TimeoutStartSec=600
TimeoutStopSec=120

# Sicherstellen, dass auch Kindprozesse (Worker, NCCL-Threads) ordentlich beendet werden.
KillMode=mixed

[Install]
WantedBy=multi-user.target
