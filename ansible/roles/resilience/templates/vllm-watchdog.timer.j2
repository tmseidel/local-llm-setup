# Timer-basierte Alternative zum einfachen Service.
# Wird derzeit NICHT verwendet — der Service läuft als Daemon (siehe vllm-watchdog.service).
# Kann aktiviert werden, wenn man den Watchdog lieber pro Timer-Tick laufen lassen möchte.
[Unit]
Description=vLLM Watchdog Timer (alternative)

[Timer]
OnBootSec=60
OnUnitActiveSec={{ resilience_vllm_check_interval }}s

[Install]
WantedBy=timers.target
